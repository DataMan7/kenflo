# /etc/systemd/system/kenflo.service
# Systemd unit for the KENFLO web application (gunicorn + Flask).
#
# 1) Copy to /etc/systemd/system/kenflo.service
# 2) systemctl daemon-reload
# 3) systemctl enable --now kenflo

[Unit]
Description=KENFLO Emotional Health Services web app (gunicorn)
After=network.target

[Service]
Type=notify
User=kenflo
Group=www-data
RuntimeDirectory=kenflo
WorkingDirectory=/opt/kenflo/kenflo_app
Environment="PATH=/opt/kenflo/kenflo_app/.venv/bin:/usr/bin"
Environment="KENFLO_SECRET_KEY=CHANGE-ME-to-a-long-random-string"
Environment="KENFLO_COOKIE_SECURE=1"
# Environment="DATABASE_URL=postgresql+psycopg://kenflo:password@localhost/kenflo"
ExecStart=/opt/kenflo/kenflo_app/.venv/bin/gunicorn -c gunicorn.conf.py "kenflo:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/kenflo /opt/kenflo

[Install]
WantedBy=multi-user.target
