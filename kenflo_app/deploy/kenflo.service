# /etc/systemd/system/kenflo.service
# Systemd unit for the KENFLO web application (gunicorn + Flask).
#
# 1) /etc/kenflo/kenflo.env   -> KENFLO_SECRET_KEY, KENFLO_COOKIE_SECURE (0600 root)
# 2) Copy to /etc/systemd/system/kenflo.service
# 3) systemctl daemon-reload
# 4) systemctl enable --now kenflo

[Unit]
Description=KENFLO Emotional Health Services web app (gunicorn)
After=network.target

[Service]
Type=notify
User=kenflo
Group=www-data
RuntimeDirectory=kenflo
WorkingDirectory=/opt/kenflo/kenflo_app
EnvironmentFile=/etc/kenflo/kenflo.env
Environment="PATH=/opt/kenflo/kenflo_app/.venv/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/kenflo/kenflo_app/.venv/bin/gunicorn -c gunicorn.conf.py "kenflo:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kenflo

[Install]
WantedBy=multi-user.target
